---
# https://github.com/rook/rook/blob/master/deploy/charts/rook-ceph/values.yaml
crds:
  enabled: true

# Quay, not Docker Hub: no anonymous pull rate limit, and nothing in-cluster
# (Harbor) is needed before Rook is up on a fresh bootstrap.
image:
  repository: quay.io/rook/ceph

nodeSelector:
  {{ lan_domain }}/node-role: storage-node
# Exists matches the nvidia.com/gpu=true:NoSchedule taint the nvidia role puts on GPU nodes
tolerations:
  - key: "nvidia.com/gpu"
    operator: "Exists"
    effect: "NoSchedule"

# -- Whether the operator should watch cluster CRD in its own namespace or not
currentNamespaceOnly: false

# -- Global log level for the operator.
# Options: `ERROR`, `WARNING`, `INFO`, `DEBUG`
logLevel: INFO

# -- If true, create & use RBAC resources
rbacEnable: true

# -- If true, create & use PSP resources
pspEnable: false

allowLoopDevices: false

resources:
  limits:
    memory: 1Gi
  requests:
    cpu: 200m
    memory: 256Mi

# Driver placement, replicas and snapshotters moved to ceph-csi-drivers in 1.20.
# Rook still provides the CSI operator, CRDs and image-set ConfigMap.
csi:
  installCsiOperator: true
  createCsiOperatorResources: true

# -- If true, scale down the rook operator.
# This is useful for administrative actions where the rook operator must be scaled down, while using gitops style tooling
# to deploy your helm charts.
scaleDownOperator: false

monitoring:
  # Requires Prometheus to be pre-installed.
  enabled: false

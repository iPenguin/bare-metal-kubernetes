---
# UpgradeConfiguration only. Do NOT add ClusterConfiguration / InitConfiguration
# fields here.
#
# Schema source (kubeadm v1beta4 types.go):
#   UpgradeConfiguration.{apply,diff,node,plan,timeouts}
#   UpgradeApplyConfiguration: kubernetesVersion, certificateRenewal, etcdUpgrade,
#     forceUpgrade, dryRun, ...
#   UpgradePlanConfiguration / UpgradeDiffConfiguration: kubernetesVersion, ...
#
# forceUpgrade MUST stay unset/false. Upstream maps it to --force-upgrade, which
# bypasses version-skew and failed preflight protections. Non-interactive apply
# uses the CLI --yes flag (allowed with --config since kubeadm 1.31 / #125566).
#
# Removed from the previous broken template (never applied during upgrade):
#   top-level kubernetesVersion, top-level cluster: {...}, networking/dnsDomain,
#   apiServer.certSANs/extraArgs, controllerManager.extraArgs, certificatesDir,
#   clusterName, controlPlaneEndpoint, certificate validity fields, etcd.local
# under a fake cluster block.
#
# Effective ClusterConfiguration lives in the kubeadm-config ConfigMap (seeded
# from kubeadm.yaml.j2). Reconfigure via kubeadm reconfigure docs, not this file.
#
apiVersion: kubeadm.k8s.io/v1beta4
kind: UpgradeConfiguration
apply:
  kubernetesVersion: v{{ kubernetes_version }}
  certificateRenewal: true
  etcdUpgrade: true
plan:
  kubernetesVersion: v{{ kubernetes_version }}
  etcdUpgrade: true
diff:
  kubernetesVersion: v{{ kubernetes_version }}
  contextLines: 5
node:
  certificateRenewal: true
  etcdUpgrade: true

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^argo-apps/(appsets|bootstrap)/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^argo-apps/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with '# renovate:' comments",
      "managerFilePatterns": [
        "/^hosts/group_vars/all/versions\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+registryUrl=(?<registryUrl>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[a-z0-9_]+:\\s*['\"]?(?<currentValue>[^'\"\\s]+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python packages"
    },
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "ansible-galaxy",
        "ansible"
      ],
      "groupName": "Ansible collections and roles"
    },
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container images"
    },
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI actions"
    },
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "argocd"
      ],
      "groupName": "Argo CD Helm charts"
    },
    {
      "description": "One PR per dependency type",
      "matchManagers": [
        "kubernetes"
      ],
      "groupName": "Argo CD app images"
    },
    {
      "description": "Pins in versions.yaml; the upgrade.yaml components keep their own PRs",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "!kubernetes/kubernetes",
        "!cri-o/cri-o",
        "!ceph/ceph",
        "!rook-ceph",
        "!cilium"
      ],
      "groupName": "Version pins"
    },
    {
      "description": "Minor and major bumps go through upgrade.yaml; approve them on the Dependency Dashboard",
      "matchDepNames": [
        "kubernetes/kubernetes",
        "cri-o/cri-o",
        "ceph/ceph",
        "rook-ceph",
        "cilium"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
